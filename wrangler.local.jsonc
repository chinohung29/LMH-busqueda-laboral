{
  // Desarrollo local sin cuenta de Cloudflare: D1 y R2 simulados, sin IA ni email reales.
  // El enlace de validación se imprime en la consola (DEV_LOG_MAIL=1) y el análisis del CV usa el plan B.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lmh-empleo-local",
  "main": "src/index.js",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "lmh-empleo", "database_id": "local", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "CVS", "bucket_name": "lmh-empleo-cvs" }],
  "vars": {
    "APP_URL": "http://localhost:8787",
    "MAIL_FROM": "no-reply@localhost",
    "ADMIN_EMAIL": "admin@localhost",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "SWEEP_USERS_PER_RUN": "20",
    "DEV_LOG_MAIL": "1"
  }
}
