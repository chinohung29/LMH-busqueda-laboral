{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lmh-empleo",
  "main": "src/index.js",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],

  // PWA estática + API en el mismo Worker. Solo /api/* pasa primero por el código.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "lmh-empleo", "database_id": "REEMPLAZAR_CON_EL_ID_DE_D1", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "CVS", "bucket_name": "lmh-empleo-cvs" }
  ],
  "ai": { "binding": "AI" },
  "send_email": [ { "name": "EMAIL" } ],

  // 10:05 a 13:05 UTC = 07:05 a 10:05 en Argentina (UTC-3, sin horario de verano).
  // Cada ejecución procesa a quienes todavía no se actualizaron hoy; así se reparte la carga.
  "triggers": { "crons": ["5 10-13 * * *"] },

  "vars": {
    "APP_URL": "https://empleo.lmhapps.com",
    "MAIL_FROM": "no-reply@lmhapps.com",
    "ADMIN_EMAIL": "lamh2903@gmail.com",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "SWEEP_USERS_PER_RUN": "20",
    "DEV_LOG_MAIL": "0"
  },

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
