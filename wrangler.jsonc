{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lmh-empleo",
  "main": "src/index.js",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  // workers.dev queda activo solo para redirigir la dirección vieja al dominio propio.
  "workers_dev": true,
  "preview_urls": false,

  // PWA estática + API en el mismo Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Todo pasa primero por el código: hace falta para redirigir la dirección vieja de workers.dev.
    "run_worker_first": true
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "lmh-empleo", "database_id": "d25974e6-c8ff-461f-a6c1-fa4d6e6a1dae", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "CVS", "bucket_name": "lmh-empleo-cvs" }
  ],
  "ai": { "binding": "AI" },
  // Envío de mails con el dominio propio (hay que habilitarlo antes: npx wrangler email sending enable lmhbusquedalaboral.com).
  "send_email": [ { "name": "EMAIL" } ],

  // Dominio propio. El workers.dev sigue activo como respaldo.
  "routes": [ { "pattern": "lmhbusquedalaboral.com", "custom_domain": true } ],

  // 10:05 a 13:05 UTC = 07:05 a 10:05 en Argentina (UTC-3, sin horario de verano).
  // Cada ejecución procesa a quienes todavía no se actualizaron hoy; así se reparte la carga.
  "triggers": { "crons": ["5 10-13 * * *"] },

  "vars": {
    "APP_URL": "https://lmhbusquedalaboral.com",
    "MAIL_FROM": "no-reply@lmhbusquedalaboral.com",
    "ADMIN_EMAIL": "lamh2903@gmail.com",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "SWEEP_USERS_PER_RUN": "20",
    "BILLING_PRICE": "10000",
    "BILLING_CURRENCY": "ARS",
    "TRIAL_DAYS": "3",
    "DEV_LOG_MAIL": "0"
  },

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
